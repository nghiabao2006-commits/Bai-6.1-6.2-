<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      Chuỗi kết nối mặc định. Ứng dụng sẽ tự dò thêm các instance SQL Server
      đang chạy trên máy (kể cả LocalDB) nếu chuỗi này không kết nối được.
    -->
    <add name="HRMDB"
         connectionString="Server=.;Database=HRMDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
